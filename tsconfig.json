{
  "compilerOptions": {
    "rootDir": "./src",
    "typeRoots": ["./node_modules/@types"],
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": false,
    "declaration": false,
    "moduleResolution": "bundler",
    "downlevelIteration": true
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"]
}